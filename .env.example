# 复制本文件为 .env 并填入你的配置：copy .env.example .env

# ---- LLM API（OpenAI 兼容格式）----
# OpenAI:      LLM_BASE_URL=https://api.openai.com/v1
# DeepSeek:    LLM_BASE_URL=https://api.deepseek.com/v1   LLM_MODEL=deepseek-chat
# 智谱 GLM:    LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=sk-你的密钥
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ---- Embedding 向量化 ----
# local = 本地模型（默认，无需额外 Key，中文效果好，首次使用自动下载模型）
# api   = 用 OpenAI 兼容的 embedding 接口（需有可用的 embedding Key）
# mock  = 伪向量，仅供没有 Key 和网络时测试流程
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
# 如果用 api，可单独指定：EMBEDDING_API_KEY=sk-xxx  EMBEDDING_BASE_URL=https://api.openai.com/v1

# ---- 运行模式 ----
# mock = 不调用真实 API，用规则答案跑通全流程（没 Key 也能测试）
# real = 调用真实 LLM（需要上面的密钥）
RAG_MODE=mock

# ---- 检索参数 ----
TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=100
